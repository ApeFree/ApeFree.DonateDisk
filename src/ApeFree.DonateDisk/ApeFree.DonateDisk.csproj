<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Title>ApeFree.DonateDisk</Title>
    <Product>ApeFree.DonateDisk</Product>
    <Version>0.0.1.1-alpha61010</Version>
    <Authors>Guijie Lee</Authors>
    <Company>ApeFree</Company>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Description>远程主动捐赠式虚拟磁盘契约核心库。定义虚拟磁盘 RPC 操作接口、文件变动事件及传输数据契约模型。</Description>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/ApeFree/ApeFree.DonateDisk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ApeFree.ApeRpc" Version="0.0.3-alpha61009" />
  </ItemGroup>

</Project>
