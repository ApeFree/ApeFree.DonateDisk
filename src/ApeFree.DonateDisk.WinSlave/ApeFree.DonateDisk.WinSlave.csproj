<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Title>ApeFree.DonateDisk.WinSlave</Title>
    <Product>ApeFree.DonateDisk.WinSlave</Product>
    <Version>0.0.1.1-alpha61010</Version>
    <Authors>Guijie Lee</Authors>
    <Company>ApeFree</Company>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Description>ApeFree.DonateDisk 远程磁盘分享客户端命令行工具</Description>

    <!-- 单文件与修剪打包配置 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.DonateDisk\ApeFree.DonateDisk.csproj" />
  </ItemGroup>

  <!-- 修剪保护：避免 RPC 反射调度与数据契约 DTO 在修剪时被意外剥离 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="ApeFree.DonateDisk" />
    <TrimmerRootAssembly Include="ApeFree.DonateDisk.WinSlave" />
    <TrimmerRootAssembly Include="ApeFree.ApeRpc" />
    <TrimmerRootAssembly Include="ApeFree.ApeRpc.BytesIO" />
    <TrimmerRootAssembly Include="STTech.BytesIO" />
    <TrimmerRootAssembly Include="STTech.CodePlus" />
    <TrimmerRootAssembly Include="ApeFree.Protocols.Json" />
  </ItemGroup>

</Project>
